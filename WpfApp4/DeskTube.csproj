<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>DeskTube.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DeskTube.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="DeskTube.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DeskTube.ico" />
  </ItemGroup>

</Project>
